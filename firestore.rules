rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null && request.auth.token.staff == true;
    }

    function isCustomer() {
      return request.auth != null && request.auth.token.email != null;
    }

    function signedIn() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    // Product photos, one document per product ({base64, version}). Kept
    // out of /products so loading the catalog doesn't pull every image.
    match /productImages/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /productCategories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /orders/{orderId} {
      allow read: if isCustomer()
        && resource.data.customerUid == request.auth.uid;
      allow read, create, update, delete: if isStaff();
    }

    match /invoices/{invoiceId} {
      allow read: if isCustomer()
        && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.customerUid == request.auth.uid;
      allow read, create, update, delete: if isStaff();
    }

    match /stockMovements/{movementId} {
      allow read, create, update, delete: if isStaff();
    }

    match /expenses/{expenseId} {
      allow read, create, update, delete: if isStaff();
    }

    match /activityLog/{entryId} {
      allow read, create: if isStaff();
      allow update, delete: if false;
    }

    match /deviceTokens/{tokenId} {
      allow read, create, update, delete: if isStaff();
    }

    match /settings/{settingId} {
      allow read, create, update, delete: if isStaff();
    }

    match /appConfig/{docId} {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }

    match /aiInvoiceDrafts/{draftId} {
      allow read, create, update, delete: if isStaff();
    }

    match /customerNotes/{noteId} {
      allow read, create, update, delete: if isStaff();
    }

    // Permanent customer book of the staff app (name/phone/city/address).
    // Customers outlive their orders (old orders are pruned), and are never
    // deleted.
    match /customers/{customerId} {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }

    match /analytics/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /marketingSubscribers/{uid} {
      allow read, write: if false;
    }

    // "Notify me when back in stock" opt-ins. Writes always go through
    // /api/stock-alerts/subscribe (Admin SDK) so this stays server-only —
    // the client route already checks ownership before writing.
    match /stockAlerts/{alertId} {
      allow read, write: if false;
    }

    // Server-only bookkeeping (Admin SDK bypasses rules; these entries exist
    // for documentation so every collection in use is listed explicitly).
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    match /systemErrors/{errorId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
